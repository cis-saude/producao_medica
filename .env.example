# =============================================================================
# Variáveis de ambiente — Dashboard de Plantões Médicos
# =============================================================================
# Copie este arquivo para .env e preencha com os valores reais.
# O arquivo .env está no .gitignore e NUNCA deve ser commitado.

# ---- Banco de dados (Supabase) ----
# Pegue em: Supabase > Project Settings > Database > Connection string > URI
# Use a string direta (porta 5432), não o pooler.
DATABASE_URL="postgresql://postgres:[SENHA]@db.[PROJETO].supabase.co:5432/postgres"

# ---- Sessão JWT ----
# Gere um valor aleatório de 32+ bytes. Exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="troque-isto-por-um-segredo-aleatorio-de-32-bytes"

# ---- URL do frontend (CORS) ----
# Em produção: URL do seu deploy Vercel, ex: https://dashboard-plantoes.vercel.app
# Em desenvolvimento: deixe vazio ou http://localhost:5173
FRONTEND_URL=""

# ---- Porta do servidor ----
PORT=3000

# ---- SMTP para envio de e-mails (opcional) ----
# Sem isso, recuperação de senha e e-mails de boas-vindas não são entregues.
# Sugestão: Resend (resend.com — free tier 3k/mês), SendGrid ou SMTP corporativo CIS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@cissaude.com.br"
